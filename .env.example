# ===================================================
# AIPEDIA.ID Environment Variables (Zero-Cost & Lean)
# ===================================================

# 1. Database (PostgreSQL - Neon, Supabase, Railway, or Local)
DATABASE_URL="postgres://user:password@localhost:5432/aipedia"

# 2. Google OAuth 2.0 (From Google Cloud Console - Free)
# Authorized redirect URI: https://yourdomain.com/api/auth/callback/google
# Local redirect URI: http://localhost:4321/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 3. Midtrans Payment Gateway (Pay-per-transaction)
# Set to 'true' for production, 'false' for sandbox
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
