---
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";

// This is a reference template page showing all AIPEDIA design patterns.
// Copy this file to create a new page or sales/landing page.
// Every section here is documented so you know what to keep and what to replace.
---

<Base
  title="Template Halaman - AIPEDIA"
  description="Referensi template untuk halaman baru."
>
  {
    /* ── 1. PAGE HEADER ──
      Large title + subtitle. The standard top of any content page.
      Use text-large-title for the main heading, text-body for the subtitle. */
  }
  <header class="page-header">
    <h1 class="text-large-title">Judul Halaman</h1>
    <p class="text-body page-subtitle">
      Subtitle atau deskripsi singkat tentang halaman ini.
    </p>
  </header>

  {
    /* ── 2. HERO SECTION (for sales/landing pages) ──
      Full-bleed image with gradient overlay and CTA buttons.
      Replace the image URL with a relevant photo. */
  }
  <section class="hero">
    <div class="hero-bg">
      <img
        src="https://images.pexels.com/photos/8849295/pexels-photo-8849295.jpeg?auto=compress&cs=tinysrgb&w=1200"
        alt=""
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <h2 class="text-large-title hero-title">Judul Produk</h2>
      <p class="text-body hero-subtitle">
        Deskripsi produk yang menarik dan menjelaskan manfaat utama.
      </p>
      <div class="hero-actions">
        <a href="#" class="btn-primary">Beli sekarang</a>
        <a href="#" class="btn-secondary">Pelajari lebih lanjut</a>
      </div>
    </div>
  </section>

  {
    /* ── 3. FEATURE GRID ──
      Three-column grid with icon + headline + description.
      Use for "features", "benefits", or "what's included" sections. */
  }
  <section class="section">
    <SectionHeading title="Fitur utama" />
    <div class="feature-grid">
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24"
            ><path
              d="M12 2L2 7l10 5 10-5-10-5z"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linejoin="round"></path><path
              d="M2 17l10 5 10-5"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linejoin="round"></path></svg
          >
        </div>
        <h3 class="text-headline">Fitur satu</h3>
        <p class="text-footnote">
          Deskripsi singkat tentang fitur ini dan mengapa itu bermanfaat.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24"
            ><path
              d="M9 11l3 3L22 4"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"></path><path
              d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
        </div>
        <h3 class="text-headline">Fitur dua</h3>
        <p class="text-footnote">
          Deskripsi singkat tentang fitur ini dan mengapa itu bermanfaat.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">
          <svg width="24" height="24" viewBox="0 0 24 24"
            ><circle
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"></circle><path
              d="M12 6v6l4 2"
              stroke="currentColor"
              stroke-width="1.5"
              fill="none"
              stroke-linecap="round"></path></svg
          >
        </div>
        <h3 class="text-headline">Fitur tiga</h3>
        <p class="text-footnote">
          Deskripsi singkat tentang fitur ini dan mengapa itu bermanfaat.
        </p>
      </div>
    </div>
  </section>

  {
    /* ── 4. INSET GROUPED LIST (Apple settings style) ──
      White rounded container with rows separated by hairline dividers.
      Use for settings, options, or any grouped list. */
  }
  <section class="section">
    <SectionHeading title="Daftar opsi" />
    <div class="group-container">
      <a href="#" class="list-row">
        <span>Opsi pertama</span>
        <svg width="16" height="16" viewBox="0 0 24 24"
          ><path
            d="M9 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
      <a href="#" class="list-row">
        <span>Opsi kedua</span>
        <svg width="16" height="16" viewBox="0 0 24 24"
          ><path
            d="M9 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
      <a href="#" class="list-row">
        <span>Opsi ketiga</span>
        <svg width="16" height="16" viewBox="0 0 24 24"
          ><path
            d="M9 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
    </div>
  </section>

  {
    /* ── 5. CTA SECTION ──
      Centered call-to-action with primary button.
      Use at the bottom of sales pages to drive conversion. */
  }
  <section class="section cta-section">
    <div class="cta-card group-container">
      <h2 class="text-title-2">Siap memulai?</h2>
      <p class="text-body cta-desc">
        Bergabung dengan ribuan UMKM dan founder yang sudah memanfaatkan AI
        untuk bisnis mereka.
      </p>
      <a href="#" class="btn-primary">Mulai sekarang</a>
    </div>
  </section>
</Base>

<style>
  /* PAGE HEADER */
  .page-header {
    text-align: center;
    padding: 16px 0 8px;
  }
  .page-subtitle {
    color: var(--color-secondary-label);
    max-width: 480px;
    margin: 8px auto 0;
  }

  /* HERO */
  .hero {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    margin-top: 32px;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.55) 60%,
      rgba(0, 0, 0, 0.8) 100%
    );
  }
  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 56px 24px 48px;
  }
  .hero-title {
    color: #fff;
    max-width: 580px;
    margin: 0 auto;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.25);
  }
  .hero-subtitle {
    color: rgba(255, 255, 255, 0.85);
    max-width: 460px;
    margin: 12px auto 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  /* BUTTONS - Apple HIG style */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    min-height: 50px;
    background: var(--color-tint);
    color: #fff;
    font-weight: 500;
    font-size: 1.0625rem;
    border-radius: 980px;
    text-decoration: none;
    transition:
      background 0.2s,
      transform 0.1s;
  }
  .btn-primary:hover {
    text-decoration: none;
    background: var(--color-tint-hover);
  }
  .btn-primary:active {
    background: var(--color-tint-pressed);
    transform: scale(0.98);
  }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    min-height: 50px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #fff;
    font-weight: 500;
    font-size: 1.0625rem;
    border-radius: 980px;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    transition:
      background 0.2s,
      transform 0.1s;
  }
  .btn-secondary:hover {
    text-decoration: none;
    background: rgba(255, 255, 255, 0.25);
  }
  .btn-secondary:active {
    transform: scale(0.98);
  }

  /* SECTIONS */
  .section {
    margin-top: 40px;
  }

  /* FEATURE GRID */
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    background: var(--color-surface-elevated);
    border-radius: var(--radius-xl);
    border: 0.5px solid var(--color-separator);
    box-shadow: var(--color-shadow);
  }
  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--color-fill);
    color: var(--color-tint);
  }
  .feature-card p {
    color: var(--color-secondary-label);
  }
  @media (min-width: 640px) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* INSET GROUPED LIST */
  .list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    min-height: 48px;
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-label);
    text-decoration: none;
    background: transparent;
    border-bottom: 0.5px solid var(--color-separator);
    transition: background 0.15s;
  }
  .list-row:last-child {
    border-bottom: none;
  }
  .list-row:hover {
    background: var(--color-fill);
    text-decoration: none;
  }
  .list-row svg {
    color: var(--color-tertiary-label);
  }

  /* CTA SECTION */
  .cta-section {
    margin-top: 48px;
  }
  .cta-card {
    text-align: center;
    padding: 40px 24px;
  }
  .cta-card h2 {
    color: var(--color-label);
  }
  .cta-desc {
    color: var(--color-secondary-label);
    max-width: 420px;
    margin: 8px auto 24px;
  }

  /* HERO RESPONSIVE */
  @media (min-width: 640px) {
    .hero-content {
      padding: 72px 32px 64px;
    }
  }
  @media (min-width: 768px) {
    .hero-content {
      padding: 96px 40px 80px;
    }
  }
</style>
