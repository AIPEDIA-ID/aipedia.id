---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Halaman Tidak Ditemukan - AIPEDIA">
  <div class="not-found-container">
    <h1
      class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-label)] mt-3"
    >
      Halaman Tidak Ditemukan
    </h1>
    <p
      class="text-sm text-[var(--color-secondary-label)] mt-2 max-w-sm mx-auto leading-relaxed"
    >
      Tautan yang Anda tuju mungkin sudah dipindahkan atau alamat URL yang
      dimasukkan kurang tepat.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
      <a href="/" class="btn-primary text-xs py-2 px-4">
        <span>Kembali ke Beranda</span>
      </a>
      <a href="/catalog" class="btn-secondary text-xs py-2 px-4">
        <span>Buka Katalog Toolkit</span>
        <Icon name="arrow-right" size={12} />
      </a>
    </div>
  </div>
</Base>

<style>
  .not-found-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 80px 16px;
    max-width: 500px;
    margin: 0 auto;
  }
  .nf-badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-tertiary-label);
    padding: 3px 10px;
    background: var(--color-fill);
    border: 1px solid var(--color-separator);
    border-radius: 100px;
  }
</style>
