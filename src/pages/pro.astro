---
import SalesLayout from "../layouts/SalesLayout.astro";
import Card from "../components/Card.astro";
import SectionBand from "../components/SectionBand.astro";
import Icon from "../components/Icon.astro";
import { getCatalog, getResources } from "../lib/data";

const { bundles } = await getCatalog();
const proBundle = bundles.find((bundle) => bundle.slug === "bundle-all-access");
const resources = await getResources();

const includedResources = proBundle
  ? resources.filter((resource) =>
      proBundle.includes.some((include) => {
        const normalized = include.endsWith("/") ? include : `${include}/`;
        return resource.id === include || resource.id.startsWith(normalized);
      }),
    )
  : [];

const useCases = [
  {
    title: "Konten & iklan",
    id: "copy-ads-facebook-ig",
    fallback: "Bikin copy iklan dari awal",
  },
  {
    title: "Chat pelanggan",
    id: "balasan-chat-customer-marah",
    fallback: "Menyusun balasan customer",
  },
  {
    title: "Rencana usaha",
    id: "business-model-canvas-bmc",
    fallback: "Menyusun Business Model Canvas",
  },
].map((item) => ({
  ...item,
  resource: resources.find((resource) => resource.id.endsWith(item.id)),
}));

const resourceCount = (category: string) =>
  includedResources.filter((resource) => resource.category === category).length;
const typeCounts = [
  { label: "Prompt teks", count: resourceCount("llm-prompt") },
  { label: "Prompt visual", count: resourceCount("visual-prompt") },
  {
    label: "Course & tutorial",
    count: resourceCount("course") + resourceCount("tutorial"),
  },
  {
    label: "Custom AI, resource & insight",
    count:
      includedResources.length -
      resourceCount("llm-prompt") -
      resourceCount("visual-prompt") -
      resourceCount("course") -
      resourceCount("tutorial"),
  },
].filter((item) => item.count > 0);

function formatPrice(price: number): string {
  return `Rp${price.toLocaleString("id-ID")}`;
}
---

<SalesLayout
  title="AIPEDIA Pro — Prompt dan materi AI untuk kerjaan bisnis"
  description="Prompt, course, tutorial, dan resource AI untuk bantu pekerjaan bisnis sehari-hari. Buka semua materi Directory dengan satu kali pembayaran."
>
  {
    proBundle && (
      <main class="sales-page">
        <section class="offer" aria-labelledby="offer-title">
          <div class="offer-copy">
            <span class="eyebrow">
              <span class="eyebrow-dot" /> DIRECTORY + PRO BUNDLE
            </span>
            <h1 id="offer-title">
              Masih mulai dari <span>prompt kosong</span> setiap kali ada
              kerjaan bisnis?
            </h1>
            <p class="lead">
              Ambil prompt dan panduan yang sesuai kebutuhan—untuk bikin konten,
              membalas pelanggan, sampai merapikan rencana usaha.
            </p>
            <p class="hero-note">
              Untuk pemilik usaha, tim marketing, dan creator yang rutin memakai
              AI.
            </p>
          </div>

          <Card
            as="aside"
            tone="dark"
            class="checkout-card"
            id="checkout"
            aria-label="Beli AIPEDIA Pro Bundle"
          >
            <div class="checkout-topline">
              <span class="bundle-label">
                {proBundle.badge || "PRO BUNDLE"}
              </span>
              <span class="bundle-lifetime">AKSES LIFETIME</span>
            </div>
            <h2>AIPEDIA Pro Bundle</h2>
            <p class="bundle-description">
              {includedResources.length} prompt, course, tutorial, dan resource
              praktis dalam AIPEDIA Directory.
            </p>
            <ul class="bundle-points">
              <li>
                <Icon name="check" size={15} /> Materi untuk konten, pelanggan,
                dan operasional
              </li>
              <li>
                <Icon name="check" size={15} /> Materi Pro baru ikut terbuka
              </li>
            </ul>
            <div class="price-line">
              <div class="price">{formatPrice(proBundle.price)}</div>
              {proBundle.originalPrice && (
                <del>{formatPrice(proBundle.originalPrice)}</del>
              )}
            </div>
            {proBundle.originalPrice &&
              proBundle.originalPrice > proBundle.price && (
                <p class="saving">
                  Hemat{" "}
                  {Math.round(
                    (1 - proBundle.price / proBundle.originalPrice) * 100,
                  )}
                  % dari harga normal
                </p>
              )}
            <p class="price-note">
              Akses seumur hidup <span>·</span> satu kali bayar
            </p>
            <form id="pro-checkout-form" data-product-slug={proBundle.slug}>
              <label for="pro-checkout-email">
                Email untuk akses dan checkout
              </label>
              <input
                id="pro-checkout-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="nama@email.com"
                required
              />
              <button class="btn-gold" type="submit">
                <span>Dapatkan Akses Pro</span>
              </button>
              <p id="pro-checkout-status" aria-live="polite">
                Email dipakai untuk mengirimkan detail akses.
              </p>
            </form>
            <a class="preview-link" href="/library">
              Belum yakin? Lihat Directory dulu{" "}
              <span aria-hidden="true">→</span>
            </a>
          </Card>
        </section>

        <SectionBand class="use-cases" aria-labelledby="use-cases-title">
          <div class="section-heading">
            <span class="section-kicker">CONTOH PAKAI</span>
            <h2 id="use-cases-title">
              Buka materi sesuai pekerjaan yang sedang kamu hadapi.
            </h2>
          </div>
          <div class="use-case-grid">
            {useCases.map(({ title, fallback, resource }, index) => (
              <a
                class="use-case"
                href={resource ? `/r/${resource.id}` : "/library"}
              >
                <span class={`use-case-number tone-${index + 1}`}>
                  0{index + 1}
                </span>
                <strong>{title}</strong>
                <span class="use-case-example">
                  {resource?.title || fallback}
                </span>
                <span class="use-case-open">
                  Lihat contoh materi <Icon name="arrow-right" size={14} />
                </span>
              </a>
            ))}
          </div>
        </SectionBand>

        <section class="bundle-details" aria-labelledby="bundle-details-title">
          <div class="details-copy">
            <span class="section-kicker">ISI BUNDLE</span>
            <h2 id="bundle-details-title">
              Satu akses untuk berbagai kebutuhan kerja.
            </h2>
            <p>
              Pilih materi berdasarkan format dan kebutuhan. Sesuaikan dengan
              konteks bisnismu, lalu gunakan di AI tool yang kamu pakai.
            </p>
            <div class="category-list">
              {typeCounts.map((item) => (
                <span class="type-chip">
                  <i />
                  <b>{item.count}</b>
                  {item.label}
                </span>
              ))}
            </div>
          </div>
        </section>

        <section class="faq" aria-labelledby="faq-title">
          <div class="section-heading">
            <span class="section-kicker">SEBELUM MEMILIH</span>
            <h2 id="faq-title">Pertanyaan yang sering ditanyakan</h2>
          </div>
          <div class="faq-list">
            <details>
              <>
                <summary>Apakah materi bisa langsung dipakai?</summary>
                <p>
                  Materi dirancang sebagai titik awal. Sesuaikan detail prompt
                  dengan produk, pelanggan, dan konteks usahamu sebelum
                  digunakan di AI tool.
                </p>
              </>
            </details>
            <details>
              <>
                <summary>Apakah pembayaran berlangganan?</summary>
                <p>
                  Tidak. Pro Bundle dibayar satu kali. Tidak ada tagihan bulanan
                  untuk akses materi AIPEDIA.
                </p>
              </>
            </details>
            <details>
              <>
                <summary>
                  Apakah sudah termasuk langganan ChatGPT atau tools AI lain?
                </summary>
                <p>
                  Belum. Bundle ini berisi materi AIPEDIA. Langganan ChatGPT,
                  Claude, Midjourney, atau layanan AI lain dibayar terpisah.
                </p>
              </>
            </details>
          </div>
          <a class="btn-gold faq-cta" href="#checkout">
            <span>Lihat harga & dapatkan akses</span>
          </a>
        </section>
      </main>
    )
  }
</SalesLayout>

<script>
  const checkoutForm = document.getElementById(
    "pro-checkout-form",
  ) as HTMLFormElement | null;
  const checkoutStatus = document.getElementById("pro-checkout-status");

  checkoutForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const emailInput = checkoutForm.querySelector<HTMLInputElement>(
      'input[name="email"]',
    );
    const submitButton = checkoutForm.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (!emailInput || !submitButton) return;

    submitButton.disabled = true;
    submitButton.textContent = "Menyiapkan pembayaran…";
    if (checkoutStatus) checkoutStatus.textContent = "Mohon tunggu sebentar.";

    try {
      const response = await fetch("/api/checkout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          productSlug: checkoutForm.dataset.productSlug,
          email: emailInput.value.trim(),
        }),
      });
      const result = await response.json();
      if (!response.ok || result.error)
        throw new Error(result.error || "Checkout belum dapat diproses.");

      const nextUrl = result.redirectUrl || result.mockRedirect;
      if (!nextUrl) throw new Error("Link pembayaran belum tersedia.");
      window.location.assign(nextUrl);
    } catch (error) {
      if (checkoutStatus)
        checkoutStatus.textContent =
          error instanceof Error
            ? error.message
            : "Terjadi kendala. Coba lagi sebentar lagi.";
      submitButton.disabled = false;
      submitButton.textContent = "Dapatkan Akses Pro";
    }
  });
</script>

<style>
  .sales-page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 24px 24px 64px;
  }
  .offer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
    padding: clamp(28px, 4.5vw, 52px);
    border: 1px solid rgba(0, 0, 0, 0.065);
    border-radius: 26px;
    background:
      radial-gradient(
        circle at 8% 100%,
        rgba(0, 113, 227, 0.07),
        transparent 40%
      ),
      radial-gradient(
        circle at 92% 0%,
        rgba(242, 201, 76, 0.12),
        transparent 38%
      ),
      linear-gradient(145deg, #fff 0%, #f1f3f7 100%);
    box-shadow:
      inset 0 1.5px #fff,
      0 12px 34px rgba(17, 24, 39, 0.09);
  }
  .offer-copy {
    max-width: 570px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 11px;
    border: 1px solid rgba(0, 113, 227, 0.15);
    border-bottom: 2px solid rgba(0, 80, 170, 0.17);
    border-radius: 999px;
    color: #28537f;
    background: linear-gradient(180deg, #fff, #edf5ff);
    box-shadow:
      inset 0 1px #fff,
      0 2px 5px rgba(0, 70, 140, 0.06);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: linear-gradient(180deg, #ffe894, #f2c94c);
    box-shadow: 0 0 0 3px rgba(242, 201, 76, 0.18);
  }
  .offer h1 {
    max-width: 570px;
    margin-top: 20px;
    color: #1d1d1f;
    font-size: clamp(2.25rem, 4.3vw, 3.55rem);
    line-height: 1.065;
    letter-spacing: -0.052em;
  }
  .offer h1 span {
    color: #a97700;
    background: linear-gradient(180deg, #fff4c7, #fce69a);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0 0.12em;
    border-radius: 5px;
  }
  .lead {
    max-width: 485px;
    margin-top: 16px;
    color: #5f646e;
    font-size: 0.98rem;
    line-height: 1.65;
  }
  .hero-note {
    margin-top: 18px;
    color: #747984;
    font-size: 0.75rem;
  }
  .checkout-card {
    position: relative;
    overflow: hidden;
    padding: 25px;
    border-radius: 20px;
  }
  .checkout-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .bundle-label {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 999px;
    color: #634b07;
    background: linear-gradient(180deg, #fff1b4, #f2d675);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.75);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.04em;
  }
  .bundle-lifetime {
    color: #c5ccd8;
    font-size: 0.59rem;
    font-weight: 650;
    letter-spacing: 0.09em;
  }
  .checkout-card h2 {
    margin-top: 15px;
    color: #fff;
    font-size: 1.22rem;
    letter-spacing: -0.03em;
  }
  .bundle-description {
    margin-top: 6px;
    color: #b6becc;
    font-size: 0.77rem;
    line-height: 1.5;
  }
  .bundle-points {
    display: grid;
    gap: 9px;
    margin-top: 16px;
    color: #e0e4ec;
    font-size: 0.71rem;
    list-style: none;
  }
  .bundle-points li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .bundle-points svg {
    flex: 0 0 auto;
    color: #f2c94c;
  }
  .price-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 20px;
  }
  .price {
    color: #fff;
    font-size: 2rem;
    font-weight: 760;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .price-line del {
    color: #8e97a6;
    font-size: 0.78rem;
  }
  .saving {
    display: inline-flex;
    margin-top: 5px;
    padding: 4px 8px;
    border: 1px solid rgba(242, 201, 76, 0.19);
    border-radius: 6px;
    color: #f3d979;
    background: rgba(242, 201, 76, 0.1);
    font-size: 0.65rem;
    font-weight: 650;
  }
  .price-note {
    margin-top: 7px;
    color: #aab2c0;
    font-size: 0.69rem;
  }
  #pro-checkout-form {
    display: grid;
    gap: 9px;
    margin-top: 18px;
  }
  #pro-checkout-form label {
    color: #d0d5df;
    font-size: 0.7rem;
    font-weight: 600;
  }
  #pro-checkout-form input {
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid #d7dbe2;
    border-bottom: 2px solid #c6cbd4;
    border-radius: 11px;
    color: var(--color-label);
    background: linear-gradient(180deg, #fff, #f5f7fa);
    font: inherit;
    font-size: 0.83rem;
  }
  #pro-checkout-form input:focus {
    outline: 3px solid rgba(0, 113, 227, 0.28);
    border-color: #65aaff;
  }
  #pro-checkout-form button {
    width: 100%;
    min-height: 46px;
    justify-content: center;
    margin-top: 2px;
  }
  #pro-checkout-form button:disabled {
    cursor: progress;
    opacity: 0.7;
  }
  #pro-checkout-status {
    min-height: 1.2em;
    color: #9fa8b7;
    font-size: 0.64rem;
    line-height: 1.4;
  }
  .preview-link {
    display: block;
    margin-top: 11px;
    color: #bfc7d4;
    font-size: 0.68rem;
    text-align: center;
    text-decoration: none;
  }
  .preview-link span {
    color: #f2c94c;
  }
  .use-cases {
    margin-top: var(--space-section);
  }
  .faq {
    max-width: 1000px;
    margin: var(--space-section) auto 0;
  }
  .section-heading {
    max-width: 620px;
    margin-bottom: 19px;
  }
  .section-kicker {
    color: #946b00;
    font-size: 0.64rem;
    font-weight: 750;
    letter-spacing: 0.11em;
  }
  .section-heading h2,
  .details-copy h2 {
    margin-top: 7px;
    color: var(--color-label);
    font-size: clamp(1.4rem, 2.8vw, 1.9rem);
    line-height: 1.16;
    letter-spacing: -0.035em;
  }
  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .use-case {
    display: flex;
    min-height: 160px;
    flex-direction: column;
    align-items: flex-start;
    padding: 17px;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-bottom: 2px solid rgba(0, 0, 0, 0.12);
    border-radius: 15px;
    color: var(--color-label);
    background: linear-gradient(155deg, #fff, #f0f2f6);
    box-shadow:
      inset 0 1px #fff,
      0 3px 9px rgba(17, 24, 39, 0.045);
    text-decoration: none;
    transition:
      transform 0.16s ease,
      box-shadow 0.16s ease;
  }
  .use-case:hover {
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px #fff,
      0 8px 18px rgba(17, 24, 39, 0.09);
  }
  .use-case-number {
    display: grid;
    width: 29px;
    height: 29px;
    place-items: center;
    margin-bottom: 15px;
    border-radius: 9px;
    font-size: 0.63rem;
    font-weight: 750;
  }
  .tone-1,
  .tone-2,
  .tone-3 {
    color: #4f5662;
    background: linear-gradient(180deg, #fff, #e9edf3);
    border: 1px solid var(--color-separator);
  }
  .use-case strong {
    font-size: 1rem;
  }
  .use-case-example {
    margin-top: 4px;
    color: var(--color-secondary-label);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .use-case-open {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: auto;
    padding-top: 15px;
    color: #1766b4;
    font-size: 0.8125rem;
    font-weight: 650;
  }
  .bundle-details {
    max-width: 820px;
    margin: 45px auto 0;
    padding: 27px;
    border: 1px solid rgba(0, 0, 0, 0.065);
    border-radius: 19px;
    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(242, 201, 76, 0.11),
        transparent 45%
      ),
      linear-gradient(155deg, #fff, #f0f2f6);
    box-shadow:
      inset 0 1px #fff,
      0 8px 22px rgba(17, 24, 39, 0.06);
  }
  .details-copy > p {
    margin-top: 8px;
    color: var(--color-secondary-label);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .category-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 17px;
  }
  .type-chip {
    display: flex;
    min-height: 40px;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 10px;
    color: #4b5059;
    background: rgba(255, 255, 255, 0.8);
    font-size: 0.8125rem;
  }
  .type-chip i {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 3px;
    background: #8b95a5;
  }
  .type-chip b {
    min-width: 18px;
    color: #1d1d1f;
    font-size: 0.77rem;
    text-align: right;
  }
  .faq {
    padding-bottom: 30px;
  }
  .faq-list {
    max-width: 760px;
    border-top: 1px solid var(--color-separator);
  }
  .faq-list details {
    border-bottom: 1px solid var(--color-separator);
  }
  .faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 15px 2px;
    color: var(--color-label);
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 650;
    list-style: none;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-list summary::after {
    content: "+";
    color: #777d87;
    font-size: 1.1rem;
    font-weight: 400;
  }
  .faq-list details[open] summary::after {
    content: "−";
  }
  .faq-list details p {
    max-width: 680px;
    padding: 0 24px 15px 2px;
    color: var(--color-secondary-label);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .faq-cta {
    margin-top: 20px;
  }
  @media (max-width: 820px) {
    .sales-page {
      padding: 17px 16px 48px;
    }
    .offer {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 25px 22px;
    }
    .offer-copy {
      max-width: 650px;
    }
    .checkout-card {
      width: 100%;
      max-width: 520px;
    }
    .use-cases,
    .faq {
      margin-top: 36px;
    }
    .bundle-details {
      margin-top: 35px;
      padding: 23px;
    }
    .use-case-grid {
      grid-template-columns: 1fr;
    }
    .use-case {
      min-height: 130px;
    }
  }
  @media (max-width: 480px) {
    .sales-page {
      padding: 11px 12px 38px;
    }
    .offer {
      gap: 19px;
      padding: 21px 16px;
      border-radius: 19px;
    }
    .offer h1 {
      margin-top: 16px;
      font-size: clamp(2rem, 9vw, 2.65rem);
    }
    .lead {
      margin-top: 12px;
      font-size: 0.88rem;
    }
    .hero-note {
      margin-top: 12px;
      font-size: 0.7rem;
    }
    .checkout-card {
      padding: 21px 18px;
    }
    .price {
      font-size: 1.9rem;
    }
    .section-heading {
      margin-bottom: 15px;
    }
    .bundle-details {
      padding: 19px 16px;
    }
    .category-list {
      grid-template-columns: 1fr;
    }
  }
</style>
