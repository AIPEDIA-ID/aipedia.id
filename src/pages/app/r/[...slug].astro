---
export const prerender = false;
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import LockedPanel from "../../../components/LockedPanel.astro";
import CopyButton from "../../../components/CopyButton.astro";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import {
  getResources,
  getCatalog,
  getCurrentUser,
  getGrants,
} from "../../../lib/data";
import { canAccess } from "../../../lib/access";

const id = Astro.params.slug;
if (!id) {
  return Astro.redirect("/404");
}

const resources = await getResources();
const resource = resources.find((r) => r.id === id);

if (!resource) {
  return Astro.redirect("/404");
}

const user = await getCurrentUser(Astro.cookies);
const grants = user ? await getGrants(user.id, Astro.cookies) : [];
const hasAccess = canAccess(resource, grants);

const markdownProcessor = await createMarkdownProcessor({
  syntaxHighlight: false,
});
const bodyHtml = resource.body
  ? (await markdownProcessor.render(resource.body)).code
  : "";
const modules = await Promise.all(
  [...(resource.modules || [])]
    .sort((a, b) => a.sequence - b.sequence)
    .map(async (module) => ({
      ...module,
      notesHtml: module.notes
        ? (await markdownProcessor.render(module.notes)).code
        : "",
    })),
);

const { products, bundles } = await getCatalog();
const allPurchasables = [...(products || []), ...(bundles || [])];

const categoryLabels: Record<string, string> = {
  "llm-prompt": "LLM Prompt",
  "visual-prompt": "Visual Prompt",
  "custom-ai": "Custom AI",
  resource: "Resource",
  tutorial: "Tutorial",
  "founder-space": "Founder Space",
  course: "Kursus AI",
};
---

<DashboardLayout
  title={`${resource.title} - AIPEDIA`}
  activeNav={resource.category}
  user={user}
>
  <div
    class:list={[
      "resource-reading-wrapper",
      { "course-reading-wrapper": resource.category === "course" },
    ]}
  >
    <a href={`/app/library/${resource.category}`} class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24"
        ><path
          d="M15 6l-6 6 6 6"
          stroke="currentColor"
          stroke-width="1.5"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
      <span>Kembali ke {categoryLabels[resource.category] ?? "Vault"}</span>
    </a>

    <header
      class:list={[
        "resource-header",
        { "course-resource-header": resource.category === "course" },
      ]}
    >
      <div class="flex items-center gap-2 mb-3 flex-wrap">
        <span class="resource-category"
          >{categoryLabels[resource.category]}</span
        >
        {
          resource.access_level === "paid" ? (
            hasAccess ? (
              <span class="badge-tactile-free">● Akses Aktif</span>
            ) : (
              <span class="badge-tactile-locked">🔒 Terkunci (Pro/Beli)</span>
            )
          ) : (
            <span class="badge-tactile-neutral">Gratis</span>
          )
        }
      </div>

      <h1
        class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-label)]"
      >
        {resource.title}
      </h1>
      <p
        class="text-base text-[var(--color-secondary-label)] mt-2 leading-relaxed"
      >
        {resource.description}
      </p>

      {
        resource.tools.length > 0 && (
          <div class="resource-tools">
            {resource.tools.map((tool) => (
              <span class="tool-tag">{tool}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      hasAccess ? (
        <div
          class:list={[
            "resource-content",
            { "course-content": resource.category === "course" },
          ]}
        >
          {resource.prompt_preview && (
            <section class="content-section">
              <div class="flex items-center justify-between mb-2">
                <h2 class="section-title mb-0">Prompt Siap Salin</h2>
              </div>
              <div class="prompt-box card overflow-hidden">
                <div class="prompt-box-header">
                  <CopyButton text={resource.prompt_preview} />
                </div>
                <pre class="prompt-code font-mono">
                  <code>{resource.prompt_preview}</code>
                </pre>
              </div>
            </section>
          )}

          {resource.steps && resource.steps.length > 0 && (
            <section class="content-section">
              <h2 class="section-title">Langkah Implementasi</h2>
              <ol class="steps-list">
                {resource.steps.map((step, i) => (
                  <li class="step-item">
                    <span class="step-number">{i + 1}</span>
                    <span class="step-text">{step}</span>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {resource.tips && resource.tips.length > 0 && (
            <section class="content-section">
              <h2 class="section-title">Tips & Trik Taktis</h2>
              <ul class="tips-list">
                {resource.tips.map((tip) => (
                  <li class="tip-item">
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="tip-icon"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{tip}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {resource.body && (
            <section class="content-section markdown-section">
              <div class="markdown-body" set:html={bodyHtml} />
            </section>
          )}

          {modules.length > 0 && (
            <section class="content-section course-modules-section">
              <div class="course-section-heading">
                <h2 class="section-title">Materi Kursus</h2>
                <span class="course-module-count">{modules.length} modul</span>
              </div>
              <div class="modules-list">
                {modules.map((mod, i) => (
                  <details class="module-item" open={i === 0}>
                    <summary class="module-summary">
                      <span class="module-seq">
                        {String(mod.sequence).padStart(2, "0")}
                      </span>
                      <span class="module-title">{mod.title}</span>
                      <svg
                        class="module-chevron"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path
                          d="m6 9 6 6 6-6"
                          stroke="currentColor"
                          stroke-width="1.75"
                          fill="none"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </summary>
                    <div class="module-content">
                      {mod.video_url && (
                        <div class="module-video">
                          <iframe
                            src={mod.video_url}
                            title={mod.title}
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen
                          />
                        </div>
                      )}
                      {mod.notesHtml && (
                        <div
                          class="markdown-body module-notes"
                          set:html={mod.notesHtml}
                        />
                      )}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          )}
        </div>
      ) : (
        <div class="resource-locked">
          <section class="content-section">
            <h2 class="section-title">Cuplikan Materi</h2>
            <p class="text-body teaser-text">{resource.teaser}</p>
          </section>

          <LockedPanel
            products={allPurchasables}
            resources={resources}
            resourceId={resource.id}
          />
        </div>
      )
    }
  </div>
</DashboardLayout>

<style>
  .resource-reading-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding-bottom: 48px;
  }

  .course-reading-wrapper {
    max-width: 1040px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-tint);
    text-decoration: none;
    margin-bottom: 20px;
  }
  .back-link:hover {
    text-decoration: none;
    opacity: 0.75;
  }

  .resource-header {
    margin-bottom: 36px;
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: var(--radius-2xl);
    background:
      radial-gradient(
        circle at 92% 0%,
        rgba(242, 201, 76, 0.13),
        transparent 36%
      ),
      linear-gradient(
        145deg,
        var(--color-dark-surface) 0%,
        var(--color-dark-surface-to) 100%
      );
    box-shadow:
      0 16px 34px -20px rgba(15, 23, 42, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .resource-category {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-accent-gold);
    text-transform: uppercase;
  }

  .resource-header h1 {
    color: #fff;
  }

  .resource-header > p {
    max-width: 720px;
    color: var(--color-dark-text-muted);
  }

  .resource-header .badge-tactile-free {
    color: #b7f3c4 !important;
    background: rgba(52, 199, 89, 0.14);
    border: 1px solid rgba(101, 220, 130, 0.28);
    box-shadow: none;
  }

  .resource-header .badge-tactile-locked {
    color: #ffe7a0 !important;
    background: rgba(242, 201, 76, 0.14);
    border: 1px solid rgba(242, 201, 76, 0.3);
    box-shadow: none;
  }

  .resource-header .badge-tactile-neutral {
    color: rgba(255, 255, 255, 0.82) !important;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: none;
  }

  .resource-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .tool-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 3px 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 100px;
    color: rgba(255, 255, 255, 0.82);
  }

  .content-section {
    margin-bottom: 40px;
  }
  .section-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-label);
    margin-bottom: 14px;
    letter-spacing: -0.01em;
  }

  .prompt-box {
    background: var(--color-surface);
    border: 1px solid var(--color-separator);
    border-radius: var(--radius-lg);
  }
  .prompt-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--color-surface-elevated);
    border-bottom: 1px solid var(--color-separator);
  }
  .prompt-code {
    padding: 18px 20px;
    margin: 0;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-label);
    background: var(--color-fill);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .steps-list {
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .step-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .step-number {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-tint);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .step-text {
    padding-top: 3px;
    color: var(--color-label);
    font-size: 1rem;
    line-height: 1.5;
  }
  .tips-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tip-item {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    color: var(--color-label);
    font-size: 0.9375rem;
  }
  .tip-item svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--color-success);
  }
  .markdown-section {
    max-width: 780px;
  }

  .markdown-body {
    max-width: 76ch;
    color: var(--color-label);
    font-size: 1rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .markdown-body :global(h2),
  .markdown-body :global(h3),
  .markdown-body :global(h4) {
    color: var(--color-label);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 1.7em 0 0.65em;
  }

  .markdown-body > :first-child {
    margin-top: 0;
  }

  .markdown-body :global(h2) {
    font-size: 1.4rem;
  }

  .markdown-body :global(h3) {
    font-size: 1.15rem;
  }

  .markdown-body :global(p) {
    margin: 0 0 1em;
  }

  .markdown-body :global(ul),
  .markdown-body :global(ol) {
    padding-left: 1.35rem;
    margin: 0 0 1.1em;
  }

  .markdown-body :global(li + li) {
    margin-top: 0.4em;
  }

  .markdown-body :global(a) {
    color: var(--color-tint);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .markdown-body :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.8rem 1rem;
    border-left: 3px solid var(--color-accent-gold);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--color-gold-surface);
    color: var(--color-secondary-label);
  }

  .markdown-body :global(code) {
    padding: 0.12em 0.36em;
    border: 1px solid var(--color-separator);
    border-radius: 5px;
    background: var(--color-fill);
    font-size: 0.88em;
  }

  .markdown-body :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--color-separator);
    border-radius: var(--radius-md);
    background: #f0f2f5;
  }

  :global(.dark) .markdown-body :global(pre) {
    background: #17191d;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .markdown-body :global(pre code) {
    padding: 0;
    border: 0;
    background: transparent;
  }

  .markdown-body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
  }

  .markdown-body :global(th),
  .markdown-body :global(td) {
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-separator);
    text-align: left;
  }

  .markdown-body :global(th) {
    background: var(--color-fill);
    font-weight: 700;
  }

  .markdown-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.25rem auto;
    border-radius: var(--radius-md);
  }
  .teaser-text {
    color: var(--color-secondary-label);
  }
  .modules-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .module-item {
    overflow: hidden;
    background: var(--surface-card, #fff);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-separator);
    border-bottom: 1.5px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 2px 8px rgba(17, 24, 39, 0.035);
  }
  :global(.dark) .module-item {
    border-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.18);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
  }
  .module-summary:focus-visible {
    outline: 2px solid var(--color-tint);
    outline-offset: -3px;
  }
  .course-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 16px;
  }
  .course-module-count {
    flex-shrink: 0;
    color: var(--color-secondary-label);
    font-size: 0.8125rem;
  }
  .module-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
  }
  .module-summary::-webkit-details-marker {
    display: none;
  }
  .module-chevron {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--color-tertiary-label);
    transition: transform 0.18s ease;
  }
  .module-item[open] .module-chevron {
    transform: rotate(180deg);
  }
  .module-content {
    display: grid;
    gap: 16px;
    padding: 0 18px 18px;
  }
  .module-video {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    background: #111318;
  }
  .module-video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .module-notes {
    color: var(--color-secondary-label);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .module-seq {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-fill);
    color: var(--color-tint);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .module-title {
    font-weight: 600;
    color: var(--color-label);
    font-size: 0.9375rem;
  }
  .course-section-heading .section-title {
    margin-bottom: 0;
  }
  @media (max-width: 639px) {
    .resource-header {
      padding: 1.5rem;
      border-radius: var(--radius-xl);
    }

    .module-summary {
      padding: 14px;
    }

    .module-content {
      padding: 0 14px 14px;
    }

    .module-title {
      font-size: 0.875rem;
    }
  }
</style>
