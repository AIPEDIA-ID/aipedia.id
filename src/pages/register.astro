---
import Base from "../layouts/Base.astro";
---

<Base title="Buat Akun - AIPEDIA">
  <div class="auth-page">
    <div class="auth-card card p-7 sm:p-9">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold tracking-tight text-[var(--color-label)]">
          Buat Akun AIPEDIA
        </h1>
        <p class="text-sm text-[var(--color-secondary-label)] mt-1">
          Dapatkan akses ke materi AI dan update berkala.
        </p>
      </div>

      <form
        name="sign-up"
        method="post"
        action="/api/auth/sign-up/email"
        data-demo-form
        class="auth-form"
      >
        <div class="form-field">
          <label for="name" class="form-label">Nama Lengkap</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input"
            placeholder="Nama Anda"
            required
            autocomplete="name"
          />
        </div>

        <div class="form-field">
          <label for="email" class="form-label">Alamat Email</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            placeholder="nama@email.com"
            required
            autocomplete="email"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="form-field">
            <label for="password" class="form-label">Kata Sandi</label>
            <input
              type="password"
              id="password"
              name="password"
              class="form-input"
              placeholder="Minimal 8 karakter"
              required
              autocomplete="new-password"
            />
          </div>

          <div class="form-field">
            <label for="confirm-password" class="form-label"
              >Konfirmasi Sandi</label
            >
            <input
              type="password"
              id="confirm-password"
              name="confirm-password"
              class="form-input"
              placeholder="Ulangi sandi"
              required
              autocomplete="new-password"
            />
          </div>
        </div>

        <label
          class="checkbox-field mt-1 flex items-start gap-2.5 cursor-pointer"
        >
          <input type="checkbox" name="terms" required class="mt-0.5" />
          <span
            class="text-sm text-[var(--color-secondary-label)] leading-relaxed"
          >
            Saya menyetujui <a
              href="/ketentuan"
              class="text-[var(--color-tint)] hover:underline"
              >Ketentuan Layanan</a
            > dan <a
              href="/privasi"
              class="text-[var(--color-tint)] hover:underline"
              >Kebijakan Privasi</a
            > AIPEDIA.
          </span>
        </label>

        <p class="demo-notice" hidden>Fitur ini belum aktif di demo.</p>

        <button type="submit" class="btn-primary-full text-sm py-2.5 mt-2">
          <span>Daftar Sekarang</span>
        </button>
      </form>

      <div class="auth-divider">
        <span>atau daftar dengan</span>
      </div>

      <a
        href="/api/auth/google"
        class="btn-secondary-full text-sm py-2.5 flex items-center justify-center gap-2"
      >
        <svg width="16" height="16" viewBox="0 0 24 24"
          ><path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
            fill="#4285F4"></path><path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path><path
            d="M5.84 14.09a6.99 6.99 0 0 1 0-4.18V7.07H2.18a11.01 11.01 0 0 0 0 9.86l3.66-2.84z"
            fill="#FBBC05"></path><path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"
            fill="#EA4335"></path></svg
        >
        <span>Akun Google</span>
      </a>

      <div
        class="mt-6 pt-5 border-t border-[var(--color-separator)] text-center"
      >
        <p class="text-sm text-[var(--color-secondary-label)]">
          Sudah memiliki akun? <a
            href="/login"
            class="text-[var(--color-tint)] font-semibold hover:underline"
            >Masuk di sini</a
          >
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .auth-page {
    display: flex;
    justify-content: center;
    padding-top: 24px;
  }
  .auth-card {
    width: 100%;
    max-width: 400px;
  }
  .auth-title {
    margin-bottom: 4px;
  }
  .auth-subtitle {
    color: var(--color-secondary-label);
    margin-bottom: 24px;
  }
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-label);
  }
  .form-input {
    padding: 12px 14px;
    min-height: 44px;
    background: var(--color-surface-elevated);
    border: 0.5px solid var(--color-separator);
    border-radius: var(--radius-md);
    color: var(--color-label);
    font-size: 1rem;
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .form-input:focus {
    border-color: var(--color-tint);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
  }
  .checkbox-field {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.8125rem;
    color: var(--color-secondary-label);
  }
  .checkbox-field input {
    margin-top: 3px;
    min-width: 20px;
    min-height: 20px;
    accent-color: var(--color-tint);
  }
  .checkbox-label a {
    color: var(--color-tint);
  }
  .demo-notice {
    padding: 10px 14px;
    background: rgba(255, 149, 0, 0.1);
    color: var(--color-warning);
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .auth-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 24px;
    text-align: center;
  }
  .auth-link {
    font-size: 0.875rem;
    color: var(--color-tint);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .auth-link:hover {
    text-decoration: underline;
  }
</style>
