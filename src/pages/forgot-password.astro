---
import Base from "../layouts/Base.astro";
---

<Base title="Lupa Kata Sandi - AIPEDIA">
  <div class="auth-page">
    <div class="auth-card card p-7 sm:p-9">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold tracking-tight text-[var(--color-label)]">
          Lupa Kata Sandi
        </h1>
        <p
          class="text-sm text-[var(--color-secondary-label)] mt-1.5 leading-relaxed"
        >
          Masukkan alamat email Anda untuk menerima tautan pemulihan kata sandi.
        </p>
      </div>

      <form
        name="reset-password"
        method="post"
        action="/api/auth/reset-password"
        data-demo-form
        class="auth-form"
      >
        <div class="form-field">
          <label for="email" class="form-label">Email Terdaftar</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            placeholder="nama@email.com"
            required
            autocomplete="email"
          />
        </div>

        <p class="demo-notice" hidden>Fitur ini belum aktif di demo.</p>

        <button type="submit" class="btn-primary-full text-sm py-2.5 mt-2">
          <span>Kirim Tautan Pemulihan</span>
        </button>
      </form>

      <div
        class="mt-6 pt-5 border-t border-[var(--color-separator)] text-center"
      >
        <a
          href="/login"
          class="text-sm text-[var(--color-tint)] font-semibold hover:underline inline-flex items-center gap-1"
        >
          <span>&larr; Kembali ke halaman Masuk</span>
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .auth-page {
    display: flex;
    justify-content: center;
    padding-top: 24px;
  }
  .auth-card {
    width: 100%;
    max-width: 400px;
  }
  .auth-title {
    margin-bottom: 4px;
  }
  .auth-subtitle {
    color: var(--color-secondary-label);
    margin-bottom: 24px;
  }
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-label);
  }
  .form-input {
    padding: 12px 14px;
    min-height: 44px;
    background: var(--color-surface-elevated);
    border: 0.5px solid var(--color-separator);
    border-radius: var(--radius-md);
    color: var(--color-label);
    font-size: 1rem;
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .form-input:focus {
    border-color: var(--color-tint);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
  }
  .demo-notice {
    padding: 10px 14px;
    background: rgba(255, 149, 0, 0.1);
    color: var(--color-warning);
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .auth-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 24px;
    text-align: center;
  }
  .auth-link {
    font-size: 0.875rem;
    color: var(--color-tint);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .auth-link:hover {
    text-decoration: underline;
  }
</style>
