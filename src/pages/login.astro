---
export const prerender = false;
import Base from "../layouts/Base.astro";
import { getCurrentUser, isMockBypassActive } from "../lib/data";

const user = await getCurrentUser(Astro.cookies);
const bypassActive = isMockBypassActive(Astro.cookies);
---

<Base title="Masuk ke Akun - AIPEDIA" user={user}>
  <div class="auth-page">
    <div class="auth-card card p-7 sm:p-9 space-y-6">
      <!-- Mock Bypass Quick Switcher Banner -->
      <div class="p-3.5 rounded-xl border border-[var(--color-separator)] bg-[var(--color-fill)] text-xs flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-1.5 font-medium text-[var(--color-label)]">
            <span class={`w-2 h-2 rounded-full ${bypassActive ? 'bg-[#34c759]' : 'bg-[#ff9500]'}`}></span>
            <span>Akses Bebas: <strong>{bypassActive ? 'AKTIF' : 'NONAKTIF'}</strong></span>
          </div>
          <a
            href={`/api/auth/mock-toggle?enable=${bypassActive ? 'false' : 'true'}`}
            class="text-[var(--color-tint)] font-semibold hover:underline"
          >
            {bypassActive ? 'Matikan' : 'Aktifkan'}
          </a>
        </div>
        <p class="text-[var(--color-secondary-label)] text-[11px] leading-relaxed">
          {bypassActive 
            ? 'Anda bisa membuka semua materi tanpa login. Matikan untuk menguji pembatasan akses.' 
            : 'Halaman materi & akun memerlukan login. Klik "Aktifkan" untuk membuka semua tanpa login.'}
        </p>
      </div>

      <div class="text-center">
        <h1 class="text-2xl font-bold tracking-tight text-[var(--color-label)]">
          Masuk ke Akun
        </h1>
        <p class="text-sm text-[var(--color-secondary-label)] mt-1">
          Akses seluruh perpustakaan prompt & modul Anda.
        </p>
      </div>

      {user && (
        <div class="p-4 rounded-xl bg-[rgba(0,113,227,0.08)] border border-[rgba(0,113,227,0.2)] text-center space-y-2">
          <p class="text-xs text-[var(--color-label)]">
            Saat ini Anda masuk sebagai <strong>{user.name}</strong> ({user.email})
          </p>
          <div class="flex items-center justify-center gap-3 text-xs">
            <a href="/dashboard" class="btn-primary-sm py-1.5 px-3">
              <span>Ke Dashboard &rarr;</span>
            </a>
            <a href="/api/auth/logout" class="text-[#ff3b30] hover:underline font-medium">
              Keluar
            </a>
          </div>
        </div>
      )}

      <!-- 1-Click Instant Demo Login -->
      <a
        href="/api/auth/mock-login"
        class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#0071e3] to-[#005fb8] hover:opacity-95 text-white text-sm font-semibold flex items-center justify-center gap-2 shadow-sm transition-all"
      >
        <span>⚡ Masuk Cepat (Akun Demo)</span>
      </a>

      <div class="auth-divider">
        <span>atau masuk dengan email</span>
      </div>

      <form
        name="sign-in"
        method="post"
        action="/api/auth/sign-in/email"
        class="auth-form"
      >
        <div class="form-field">
          <label for="email" class="form-label">Email Terdaftar</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input"
            placeholder="demo@aipedia.id"
            value="demo@aipedia.id"
            required
            autocomplete="email"
          />
        </div>

        <div class="form-field">
          <div class="flex items-center justify-between">
            <label for="password" class="form-label">Kata Sandi</label>
            <a
              href="/forgot-password"
              class="text-sm text-[var(--color-tint)] hover:underline"
              >Lupa kata sandi?</a
            >
          </div>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input"
            placeholder="••••••••"
            value="demo1234"
            required
            autocomplete="current-password"
          />
        </div>

        <button type="submit" class="btn-primary-full text-sm py-2.5 mt-2">
          <span>Masuk</span>
        </button>
      </form>

      <div class="auth-divider">
        <span>atau lanjutkan dengan</span>
      </div>

      <a
        href="/api/auth/google"
        class="btn-secondary-full text-sm py-2.5 flex items-center justify-center gap-2"
      >
        <svg width="16" height="16" viewBox="0 0 24 24"
          ><path
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
            fill="#4285F4"></path><path
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            fill="#34A853"></path><path
            d="M5.84 14.09a6.99 6.99 0 0 1 0-4.18V7.07H2.18a11.01 11.01 0 0 0 0 9.86l3.66-2.84z"
            fill="#FBBC05"></path><path
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"
            fill="#EA4335"></path></svg
        >
        <span>Akun Google</span>
      </a>

      <div
        class="mt-6 pt-5 border-t border-[var(--color-separator)] text-center"
      >
        <p class="text-sm text-[var(--color-secondary-label)]">
          Belum memiliki akun? <a
            href="/register"
            class="text-[var(--color-tint)] font-semibold hover:underline"
            >Daftar sekarang</a
          >
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .auth-page {
    display: flex;
    justify-content: center;
    padding-top: 24px;
  }
  .auth-card {
    width: 100%;
    max-width: 400px;
  }
  .auth-title {
    margin-bottom: 4px;
  }
  .auth-subtitle {
    color: var(--color-secondary-label);
    margin-bottom: 24px;
  }
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-label);
  }
  .form-input {
    padding: 12px 14px;
    min-height: 44px;
    background: var(--color-surface-elevated);
    border: 0.5px solid var(--color-separator);
    border-radius: var(--radius-md);
    color: var(--color-label);
    font-size: 1rem;
    outline: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .form-input:focus {
    border-color: var(--color-tint);
    box-shadow: 0 0 0 3px rgba(0, 113, 227, 0.12);
  }
  .demo-notice {
    padding: 10px 14px;
    background: rgba(255, 149, 0, 0.1);
    color: var(--color-warning);
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    text-align: center;
  }
  .auth-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0;
    color: var(--color-tertiary-label);
    font-size: 0.8125rem;
  }
  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    height: 0.5px;
    background: var(--color-separator);
  }
  .btn-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 12px 16px;
    min-height: 44px;
    background: var(--color-surface-elevated);
    border: 0.5px solid var(--color-separator);
    border-radius: var(--radius-md);
    color: var(--color-label);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-google:hover {
    background: var(--color-fill);
  }
  .auth-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 24px;
    text-align: center;
  }
  .auth-link {
    font-size: 0.875rem;
    color: var(--color-tint);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .auth-link:hover {
    text-decoration: underline;
  }
</style>
