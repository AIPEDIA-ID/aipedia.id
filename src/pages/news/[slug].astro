---
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { newsArticles } from "../../data/news";

export async function getStaticPaths() {
  return newsArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

if (!article) {
  return Astro.redirect("/404");
}

const otherArticles = newsArticles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 2);
---

<Base title={`${article.title} - AIPEDIA`}>
  <div class="article-container">
    <!-- Back Navigation -->
    <a href="/news" class="back-link">
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M19 12H5M12 19l-7-7 7-7"></path>
      </svg>
      <span>Kembali ke Updates</span>
    </a>

    <!-- Article Header -->
    <header class="article-header">
      <div class="article-badges">
        <span class="chip-sm">{article.category}</span>
      </div>

      <h1 class="article-title">{article.title}</h1>

      <div class="article-meta-bar">
        <div class="author-block">
          <div class="author-avatar">
            {article.author.name.charAt(0)}
          </div>
          <div class="author-info">
            <span class="author-name">{article.author.name}</span>
            <span class="author-role">{article.author.role}</span>
          </div>
        </div>

        <div class="article-timestamp">
          <span>{article.date}</span>
          <span>•</span>
          <span>{article.readTime}</span>
        </div>
      </div>
    </header>

    <!-- Hero Image -->
    <div class="article-cover card">
      <img src={article.thumbnail} alt={article.title} />
    </div>

    <!-- Article Body Content -->
    <div class="article-body card p-6 sm:p-10">
      <div class="article-prose" set:html={article.content} />

      <!-- In-Article Share / Action Row -->
      <div
        class="article-share-row mt-8 pt-6 border-t border-[var(--color-separator)] flex items-center justify-between"
      >
        <button class="chip text-xs copy-btn" id="share-link-btn" type="button">
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
            ></path>
          </svg>
          <span id="copy-btn-text">Salin Link</span>
        </button>
      </div>
    </div>

    <!-- In-Article Newsletter Well (Clean & Focused) -->
    <Card as="div" tone="dark" class="article-newsletter">
      <div class="max-w-lg">
        <h3 class="text-base font-bold">
          Dapatkan update AI mingguan
        </h3>
        <p
          class="text-xs mt-1 mb-4 leading-relaxed"
        >
          Tips praktis, studi kasus, dan prompt siap pakai setiap Senin pagi di
          email Anda.
        </p>

        <form class="flex flex-col sm:flex-row gap-2" id="in-article-form">
          <input
            type="email"
            placeholder="Ketik email Anda..."
            required
            class="px-4 py-2 text-sm bg-white border border-[#bcc0ca] rounded-full focus:outline-none focus:ring-2 focus:ring-[#f59e0b] flex-1"
          />
          <button type="submit" class="btn-gold btn-gold-sm">
            <span>Daftar</span>
          </button>
        </form>
      </div>
    </Card>

    <!-- Related Articles -->
    {
      otherArticles.length > 0 && (
        <div class="related-section">
          <h3 class="text-lg font-bold tracking-tight text-[var(--color-label)] mb-5">
            Artikel Terkait
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {otherArticles.map((rel) => (
              <a
                href={`/news/${rel.slug}`}
                class="related-card card p-4 flex gap-3.5 no-underline text-inherit group"
              >
                <div class="w-20 h-20 rounded-lg overflow-hidden shrink-0 bg-[var(--color-background)]">
                  <img
                    src={rel.thumbnail}
                    alt={rel.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  />
                </div>
                <div class="flex flex-col justify-center gap-1">
                  <span class="text-xs font-semibold text-[var(--color-tint)]">
                    {rel.category}
                  </span>
                  <h4 class="text-sm font-semibold line-clamp-2 text-[var(--color-label)] group-hover:text-[var(--color-tint)] transition-colors leading-snug">
                    {rel.title}
                  </h4>
                  <span class="text-xs text-[var(--color-tertiary-label)]">
                    {rel.readTime}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</Base>

<script>
  const copyBtn = document.getElementById("share-link-btn");
  const copyText = document.getElementById("copy-btn-text");

  if (copyBtn && copyText) {
    copyBtn.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href);
      copyText.innerText = "Tautan Disalin!";
      setTimeout(() => {
        copyText.innerText = "Salin Tautan";
      }, 2000);
    });
  }

  const inArticleForm = document.getElementById(
    "in-article-form",
  ) as HTMLFormElement | null;
  if (inArticleForm) {
    inArticleForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = inArticleForm.querySelector(
        "input[type='email']",
      ) as HTMLInputElement | null;
      if (!input || !input.value) return;
      alert(`Terima kasih! Email ${input.value} telah didaftarkan.`);
      input.value = "";
    });
  }
</script>

<style>
  .article-container {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-secondary-label);
    text-decoration: none;
    margin-bottom: 24px;
    transition: color 0.15s ease;
  }
  .back-link:hover {
    color: var(--color-tint);
  }

  .article-header {
    margin-bottom: 24px;
  }

  .article-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .article-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--color-label);
    margin-bottom: 18px;
  }
  @media (min-width: 640px) {
    .article-title {
      font-size: 2.35rem;
    }
  }

  .article-meta-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--color-separator);
  }

  .author-block {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-tint);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
  }

  .author-info {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.84375rem;
    font-weight: 600;
    color: var(--color-label);
  }

  .author-role {
    font-size: 0.71875rem;
    color: var(--color-secondary-label);
  }

  .article-timestamp {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--color-tertiary-label);
  }

  .article-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-background);
    margin-bottom: 32px;
  }
  .article-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-body {
    background: #ffffff;
    margin-bottom: 48px;
  }

  .article-newsletter {
    margin-bottom: 56px;
    padding: 24px;
  }
  @media (min-width: 640px) {
    .article-newsletter {
      padding: 32px 36px;
    }
  }

  .related-section {
    padding-top: 40px;
    border-top: 1px solid var(--color-separator);
  }

  .article-prose {
    font-size: 1rem;
    line-height: 1.75;
    color: #2c2c2e;
  }
  .article-prose :global(.lead) {
    font-size: 1.125rem;
    line-height: 1.65;
    color: #1d1d1f;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .article-prose :global(h2) {
    font-size: 1.35rem;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 12px;
    letter-spacing: -0.015em;
    color: var(--color-label);
  }
  .article-prose :global(p) {
    margin-bottom: 16px;
  }
  .article-prose :global(ol),
  .article-prose :global(ul) {
    margin-bottom: 20px;
  }

  .mini {
    font-size: 0.625rem !important;
    padding: 0.1rem 0.45rem !important;
  }
</style>
