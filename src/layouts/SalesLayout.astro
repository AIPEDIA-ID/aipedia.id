---
import "../styles/tokens.css";
import BrandLogo from "../components/BrandLogo.astro";
import CheckoutHandler from "../components/CheckoutHandler.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="sales-header-wrap">
      <header class="sales-header">
        <BrandLogo size="md" />
        <a href="/library">Jelajahi Directory <span aria-hidden="true">→</span></a>
      </header>
    </div>
    <slot />
    <CheckoutHandler />
  </body>
</html>

<style>
  body { background-color: var(--color-background); background-image: radial-gradient(circle at 88% 10%,rgba(242,201,76,.065),transparent 33%),radial-gradient(circle at 8% 52%,rgba(0,113,227,.045),transparent 38%),radial-gradient(rgba(0,0,0,.026) 1px,transparent 1px); background-size: 100% 100%,100% 100%,24px 24px; background-attachment: fixed; }
  .sales-header-wrap { position: relative; z-index: 2; display: flex; justify-content: center; padding: 12px 16px 8px; }
  .sales-header { display: flex; align-items: center; justify-content: space-between; width: 100%; max-width: 860px; height: 52px; padding: 0 12px 0 18px; border: 1px solid rgba(0,0,0,.08); border-radius: 999px; background: rgba(255,255,255,.86); box-shadow: 0 8px 24px rgba(18,27,44,.07),inset 0 1px #fff; backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }
  .sales-header > a:last-child { padding: 8px 12px; border: 1px solid rgba(0,113,227,.12); border-bottom: 2px solid rgba(0,80,170,.15); border-radius: 999px; color: #1766b4; background: linear-gradient(180deg,#fff,#f1f6fd); box-shadow: inset 0 1px #fff; font-size: .75rem; font-weight: 600; text-decoration: none; }
  .sales-header > a:last-child span { margin-left: 3px; }
  @media (max-width: 600px) { .sales-header-wrap { padding: 9px 12px 5px; } .sales-header { height: 48px; padding-left: 13px; } .sales-header > a:last-child { padding: 7px 10px; font-size: .7rem; } }
</style>
