---
interface NavItem {
  label: string;
  href: string;
  icon: string;
  badge?: string;
}

interface Props {
  items: NavItem[];
  currentPath?: string;
  user?: { name: string; email: string } | null;
  variant?: "desktop" | "mobile";
  activeLabel?: string;
}

const { items, currentPath = "", user = null, variant = "desktop", activeLabel } = Astro.props;

function isActive(item: NavItem, path: string, selectedLabel?: string): boolean {
  if (selectedLabel) return item.label === selectedLabel;
  return path === item.href || path.startsWith(item.href + "/");
}

const icons: Record<string, string> = {
  dashboard: `<rect x="3" y="3" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="13" y="3" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="3" y="13" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><rect x="13" y="13" width="8" height="8" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  library: `<path d="M4 5.5C4 4.67 4.67 4 5.5 4H9v15H5.5C4.67 19 4 18.33 4 17.5v-12Z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 4h6c.83 0 1.5.67 1.5 1.5v12c0 .83-.67 1.5-1.5 1.5H9" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M15 7.5C15 6.67 15.67 6 16.5 6H19c.83 0 1.5.67 1.5 1.5v10c0 .83-.67 1.5-1.5 1.5h-2.5c-.83 0-1.5-.67-1.5-1.5v-10Z" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  orders: `<path d="M3 3h2l2.4 13.5a2 2 0 0 0 2 1.5h8.7a2 2 0 0 0 2-1.6L23 8H6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="20" r="1.5" fill="currentColor"/><circle cx="18" cy="20" r="1.5" fill="currentColor"/>`,
  settings: `<path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  bell: `<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M13.73 21a2 2 0 0 1-3.46 0" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>`,
  person: `<circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M4 20c0-3.31 3.58-6 8-6s8 2.69 8 6" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>`,
  card: `<rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/>`,
  download: `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  logout: `<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
};

const initials = user ? user.name.split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase() : "";
---

<aside class:list={["settings-sidebar", variant === "mobile" && "mobile-sidebar"]} aria-label="Menu sidebar">
  {user && (
    <div class="sidebar-profile">
      <div class="sidebar-avatar">{initials}</div>
      <div class="sidebar-profile-info">
        <span class="sidebar-name">{user.name.split(" ")[0]}</span>
        <span class="sidebar-email">{user.email}</span>
      </div>
    </div>
  )}

  <nav class="sidebar-nav">
    {items.map((item) => (
      <a
        href={item.href}
        class:list={["sidebar-item", { active: isActive(item, currentPath, activeLabel) }]}
        aria-current={isActive(item, currentPath, activeLabel) ? "page" : undefined}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" set:html={icons[item.icon] ?? icons.settings} />
        <span class="sidebar-item-label">{item.label}</span>
        {item.badge && <span class="sidebar-item-badge">{item.badge}</span>}
      </a>
    ))}
  </nav>
</aside>

<style>
  .settings-sidebar {
    display: none;
    width: 224px;
    flex-shrink: 0;
    position: sticky;
    top: calc(52px + var(--safe-top) + 24px);
    align-self: flex-start;
  }
  .sidebar-profile {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 12px 16px;
    border-bottom: 0.5px solid var(--color-separator);
    margin-bottom: 12px;
  }
  .sidebar-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-tint);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    flex-shrink: 0;
  }
  .sidebar-profile-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
  }
  .sidebar-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-label);
    white-space: nowrap;
  }
  .sidebar-email {
    font-size: 0.6875rem;
    color: var(--color-tertiary-label);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    min-height: 42px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-secondary-label);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background 0.15s, color 0.15s;
  }
  .sidebar-item:hover {
    background: var(--color-fill);
    color: var(--color-label);
    text-decoration: none;
  }
  .sidebar-item.active {
    background: rgba(0, 113, 227, 0.1);
    color: var(--color-tint);
    font-weight: 600;
  }
  .sidebar-item.active svg {
    color: var(--color-tint);
  }
  .sidebar-item svg {
    color: var(--color-tertiary-label);
    flex-shrink: 0;
    transition: color 0.15s;
  }
  .sidebar-item:hover svg {
    color: var(--color-secondary-label);
  }
  .sidebar-item-label {
    flex: 1;
  }
  .sidebar-item-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 2px 7px;
    background: var(--color-fill-strong);
    border-radius: 100px;
    color: var(--color-secondary-label);
  }
  .sidebar-item.active .sidebar-item-badge {
    background: rgba(0, 113, 227, 0.12);
    color: var(--color-tint);
  }

  /* Mobile: show as horizontal scroll pills */
  .settings-sidebar.mobile-sidebar {
    display: flex;
    flex-direction: column;
    width: 100%;
    position: relative;
    top: 0;
    margin-bottom: 20px;
  }
  .settings-sidebar.mobile-sidebar .sidebar-profile {
    display: none;
  }
  .settings-sidebar.mobile-sidebar .sidebar-nav {
    flex-direction: row;
    gap: 8px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .settings-sidebar.mobile-sidebar .sidebar-item {
    flex-shrink: 0;
    padding: 8px 14px;
    min-height: 38px;
    background: var(--color-surface-elevated);
    border: 0.5px solid var(--color-separator);
    white-space: nowrap;
  }
  .settings-sidebar.mobile-sidebar .sidebar-item.active {
    border-color: rgba(0, 113, 227, 0.25);
    background: rgba(0, 113, 227, 0.1);
  }
  .settings-sidebar.mobile-sidebar .sidebar-item svg {
    width: 18px;
    height: 18px;
  }

  @media (min-width: 880px) {
    .settings-sidebar {
      display: block;
    }
    .settings-sidebar.mobile-sidebar {
      display: none;
    }
  }
</style>
