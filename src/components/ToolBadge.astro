  HuggingFace:
    "bg-[rgba(245,158,11,0.12)] text-[#d97706] border-[rgba(245,158,11,0.25)] dark:bg-[rgba(245,158,11,0.18)] dark:text-[#fbbf24]",
  GitHub:
    "bg-[rgba(15,15,15,0.08)] text-[#111827] border-[rgba(15,15,15,0.2)] dark:bg-[rgba(255,255,255,0.1)] dark:text-[#f3f4f6]",
  Meta:
    "bg-[rgba(6,104,225,0.1)] text-[#0668e1] border-[rgba(6,104,225,0.25)] dark:bg-[rgba(6,104,225,0.18)] dark:text-[#60a5fa]",
  Slack:
    "bg-[rgba(224,30,90,0.1)] text-[#e01e5a] border-[rgba(224,30,90,0.25)] dark:bg-[rgba(224,30,90,0.18)] dark:text-[#f43f5e]",
  Vercel:
    "bg-[rgba(15,15,15,0.08)] text-[#111827] border-[rgba(15,15,15,0.2)] dark:bg-[rgba(255,255,255,0.1)] dark:text-[#f3f4f6]",
  "Nano Banana":
    "bg-[rgba(234,179,8,0.12)] text-[#ca8a04] border-[rgba(234,179,8,0.25)] dark:bg-[rgba(234,179,8,0.18)] dark:text-[#facc15]",
};

const iconInfo = vendorIcons[tool];
const style =
  brandStyles[tool] ||
  "bg-[var(--color-fill)] text-[var(--color-secondary-label)] border-[var(--border)]";

const sizeClasses = iconOnly
  ? { xs: "w-5 h-5 p-0.5", sm: "w-6 h-6 p-1", md: "w-7 h-7 p-1.5" }[size]
  : {
      xs: "text-[11px] px-2 py-0.5 gap-1",
      sm: "text-xs px-2.5 py-0.5 gap-1.5",
      md: "text-sm px-3 py-1 gap-2",
    }[size];

const iconSizeClasses = {
  xs: "w-3 h-3",
  sm: "w-3.5 h-3.5",
  md: "w-4 h-4",
}[size];
---

<span
  class={`inline-flex items-center justify-center rounded-full font-medium border transition-colors ${sizeClasses} ${style} ${className}`}
  title={tool}
>
  {
    showIcon &&
      iconInfo &&
      (iconInfo.isImage ? (
        <img
          src={iconInfo.src}
          alt={tool}
          class={`${iconSizeClasses} object-contain shrink-0 rounded-full`}
          loading="lazy"
          width="14"
          height="14"
        />
      ) : (
        <span
          class={`inline-block ${iconSizeClasses} shrink-0 bg-current`}
          style={`mask: url(${iconInfo.src}) no-repeat center / contain; -webkit-mask: url(${iconInfo.src}) no-repeat center / contain;`}
          aria-hidden="true"
        />
      ))
  }
  {
    showIcon && !iconInfo && tool === "Nano Banana" && (
      <span class="text-xs shrink-0" aria-hidden="true">
        🍌
      </span>
    )
  }
  {!iconOnly && <span>{tool}</span>}
</span>
