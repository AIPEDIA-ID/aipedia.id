---
interface Props {
  tool: string;
  size?: "xs" | "sm" | "md";
  class?: string;
  showIcon?: boolean;
  iconOnly?: boolean;
}

const {
  tool,
  size = "sm",
  class: className = "",
  showIcon = true,
  iconOnly = false,
} = Astro.props;

// Vendor icon map from public/vendors
const vendorIcons: Record<string, { src: string; isImage?: boolean }> = {
  ChatGPT: { src: "/vendors/chatgpt.svg" },
