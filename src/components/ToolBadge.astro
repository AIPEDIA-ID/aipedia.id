  "Google Sheets":
    "bg-[rgba(22,163,74,0.1)] text-[#16a34a] border-[rgba(22,163,74,0.25)] dark:bg-[rgba(22,163,74,0.18)] dark:text-[#4ade80]",
  Discord:
    "bg-[rgba(88,101,242,0.1)] text-[#5865f2] border-[rgba(88,101,242,0.25)] dark:bg-[rgba(88,101,242,0.18)] dark:text-[#818cf8]",
