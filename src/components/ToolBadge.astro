  Notion:
    "bg-[rgba(15,15,15,0.08)] text-[#111827] border-[rgba(15,15,15,0.2)] dark:bg-[rgba(255,255,255,0.1)] dark:text-[#f3f4f6] dark:border-[rgba(255,255,255,0.15)]",
  Zapier:
    "bg-[rgba(255,74,0,0.1)] text-[#ea580c] border-[rgba(255,74,0,0.25)] dark:bg-[rgba(255,74,0,0.18)] dark:text-[#fb923c]",
  Make:
