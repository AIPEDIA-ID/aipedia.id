  Gemini:
    "bg-[rgba(26,115,232,0.1)] text-[#1a73e8] border-[rgba(26,115,232,0.25)] dark:bg-[rgba(26,115,232,0.18)] dark:text-[#60a5fa]",
  "Google Gemini":
    "bg-[rgba(26,115,232,0.1)] text-[#1a73e8] border-[rgba(26,115,232,0.25)] dark:bg-[rgba(26,115,232,0.18)] dark:text-[#60a5fa]",
  Perplexity:
    "bg-[rgba(16,185,129,0.1)] text-[#10b981] border-[rgba(16,185,129,0.25)] dark:bg-[rgba(16,185,129,0.18)] dark:text-[#34d399]",
  DeepSeek:
