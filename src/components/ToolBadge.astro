  "Claude Projects": { src: "/vendors/claude.svg" },
  Anthropic: { src: "/vendors/anthropic.svg" },
  Gemini: { src: "/vendors/gemini.svg" },
  "Google Gemini": { src: "/vendors/gemini.svg" },
  Perplexity: { src: "/vendors/perplexity.svg" },
  Midjourney: { src: "/vendors/midjourney.png", isImage: true },
  DeepSeek: { src: "/vendors/deepseek.svg" },
  ElevenLabs: { src: "/vendors/elevenlabs.svg" },
  Notion: { src: "/vendors/notion.svg" },
