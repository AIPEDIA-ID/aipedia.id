  "Custom GPT":
    "bg-[rgba(16,163,127,0.1)] text-[#10a37f] border-[rgba(16,163,127,0.25)] dark:bg-[rgba(16,163,127,0.18)] dark:text-[#2dd4bf]",
  OpenAI:
    "bg-[rgba(16,163,127,0.1)] text-[#10a37f] border-[rgba(16,163,127,0.25)] dark:bg-[rgba(16,163,127,0.18)] dark:text-[#2dd4bf]",
  Claude:
    "bg-[rgba(217,119,87,0.1)] text-[#d97757] border-[rgba(217,119,87,0.25)] dark:bg-[rgba(217,119,87,0.18)] dark:text-[#f87171]",
  "Claude Projects":
