  ChatGPT:
    "bg-[rgba(16,163,127,0.1)] text-[#10a37f] border-[rgba(16,163,127,0.25)] dark:bg-[rgba(16,163,127,0.18)] dark:text-[#2dd4bf]",
  "OpenAI API":
