---
interface Props {
  label?: string;
  href?: string;
  note?: string;
}

const { label = "Beli sekarang", href, note = "Segera hadir" } = Astro.props;
---

{href ? (
  <a href={href} class="placeholder-btn">
    <span>{label}</span>
    <span class="placeholder-note">{note}</span>
  </a>
) : (
  <button class="placeholder-btn" type="button">
    <span>{label}</span>
    <span class="placeholder-note">{note}</span>
  </button>
)}

<style>
  .placeholder-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    min-height: 44px;
    background: var(--color-tint);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .placeholder-btn:hover {
    text-decoration: none;
    opacity: 0.85;
  }
  .placeholder-btn:active {
    opacity: 0.6;
  }
  .placeholder-note {
    font-size: 0.6875rem;
    font-weight: 500;
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 100px;
  }
</style>
