---
interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 18, class: className = "", strokeWidth = 1.85 } = Astro.props;

// Pure Joyful, Minimalist, Human-Centered Icons (Clean & Free of generic AI gimmicks)
const icons: Record<string, string> = {
