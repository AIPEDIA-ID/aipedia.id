---
interface Props {
  title: string;
  description: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title, description, actionLabel, actionHref } = Astro.props;
---

<div class="empty-state">
  <h3 class="empty-title">{title}</h3>
  <p class="empty-desc">{description}</p>
  {actionLabel && actionHref && (
    <a href={actionHref} class="empty-action">{actionLabel}</a>
  )}
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 48px 24px;
    text-align: center;
  }
  .empty-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-label);
  }
  .empty-desc {
    font-size: 0.875rem;
    color: var(--color-secondary-label);
    max-width: 320px;
  }
  .empty-action {
    margin-top: 8px;
    padding: 10px 20px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    background: var(--color-tint);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: 100px;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .empty-action:hover {
    text-decoration: none;
    opacity: 0.85;
  }
  .empty-action:active {
    opacity: 0.6;
  }
</style>
