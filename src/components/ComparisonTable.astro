---
interface ComparisonItem {
  generic: string;
  specialist: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  genericTitle?: string;
  specialistTitle?: string;
  specialistBadge?: string;
  items?: ComparisonItem[];
  class?: string;
}

const defaultItems: ComparisonItem[] = [
  {
    generic: "Jawaban generik dan terlalu umum seperti buku teks teori",
    specialist: "17+ AI Spesialis terlatih khusus per domain bisnis Indonesia",
  },
  {
    generic: "Harus susun prompt panjang dan framework sendiri dari nol",
    specialist: "Template, framework, dan instruction domain-expertise sudah tertanam",
  },
  {
    generic: "Kualitas output naik-turun tergantung mood prompt pengguna",
    specialist: "Knowledge base teruji, hasil konsisten dan terstruktur setiap sesi chat",
  },
  {
    generic: "Riset manual aturan dan regulasi lokal, makan waktu berjam-jam",
    specialist: "Data dan best practice Indonesia langsung siap pakai tanpa riset ulang",
  },
  {
    generic: "Bisa halusinasi dan tidak paham konteks praktis UMKM",
    specialist: "Dirancang praktisi 9+ tahun pengalaman eksekusi digital & bisnis",
  },
  {
    generic: "Langganan bulanan mahal bertumpuk untuk banyak platform",
    specialist: "Sekali bayar untuk akses selamanya, tanpa tagihan bulanan",
  },
];

const {
  title = "Dibandingkan AI Biasa",
  subtitle = "Kenapa memakai AI yang dilatih khusus jauh lebih menguntungkan dibanding prompt kosong.",
  genericTitle = "ChatGPT / Gemini Generic",
  specialistTitle = "AIPEDIA Spesialis",
  specialistBadge = "LEBIH PRESISI & HEMAT",
  items = defaultItems,
  class: className = "",
} = Astro.props;
---

<div class:list={["comparison-wrapper", className]}>
  <div class="comparison-header">
    <span class="comparison-kicker">KOMPARASI OBJEKTIF</span>
    <h2 class="comparison-title">{title}</h2>
    {subtitle && <p class="comparison-subtitle">{subtitle}</p>}
  </div>

  <div class="comparison-grid">
    <!-- Generic Column -->
    <div class="comparison-col generic-col">
      <div class="col-head">
        <div class="col-icon-cross">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <h3 class="col-title">{genericTitle}</h3>
          <span class="col-caption">Prompt kosong tanpa framework</span>
        </div>
      </div>

      <ul class="comparison-list">
        {items.map((item) => (
          <li class="generic-item">
            <span class="mark-cross" aria-hidden="true">✕</span>
            <span>{item.generic}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Specialist Column -->
    <div class="comparison-col specialist-col">
      <div class="specialist-ambient-glow"></div>
      <div class="specialist-glass-shine"></div>

      <div class="col-badge">
        <span class="badge-sparkle">✦</span>
        <span>{specialistBadge}</span>
      </div>

      <div class="col-head">
        <div class="col-icon-check">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <h3 class="col-title highlight-blue">{specialistTitle}</h3>
          <span class="col-caption">Teroptimasi dengan SOP & template</span>
        </div>
      </div>

      <ul class="comparison-list">
        {items.map((item) => (
          <li class="specialist-item">
            <span class="mark-check" aria-hidden="true">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>{item.specialist}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .comparison-wrapper {
    margin: 56px 0;
  }

  .comparison-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 36px;
  }

  .comparison-kicker {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    color: var(--color-gold-text, #78350f);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .comparison-title {
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 800;
    color: var(--color-label, #1d1d1f);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 10px;
  }

  .comparison-subtitle {
    font-size: 0.94rem;
    color: var(--color-secondary-label, #6e6e73);
    line-height: 1.6;
    margin: 0;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    align-items: stretch;
  }

  @media (max-width: 768px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }

  .comparison-col {
    position: relative;
    padding: 30px 26px;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
  }

  .generic-col {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.75) 0%, rgba(248, 250, 252, 0.65) 100%);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.02), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
  }

  .specialist-col {
    background: linear-gradient(180deg, #ffffff 0%, #f4f8fe 60%, #eaf3ff 100%);
    border: 1.5px solid rgba(0, 113, 227, 0.35);
    box-shadow:
      0 16px 40px rgba(0, 113, 227, 0.09),
      0 0 0 1px rgba(255, 255, 255, 0.8),
      inset 0 1.5px 0 #fff;
    backdrop-filter: blur(24px);
    overflow: hidden;
  }

  .specialist-ambient-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 113, 227, 0.12) 0%, transparent 70%);
    pointer-events: none;
    filter: blur(25px);
  }

  .specialist-glass-shine {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 38%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
  }

  .col-badge {
    position: absolute;
    top: -12px;
    right: 24px;
    background: linear-gradient(180deg, #2b8bf5 0%, #0071e3 50%, #005bb5 100%);
    color: #fff;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    padding: 5px 12px;
    border-radius: 999px;
    box-shadow:
      0 4px 12px rgba(0, 113, 227, 0.35),
      inset 0 1px 0.5px rgba(255, 255, 255, 0.5);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    z-index: 2;
  }

  .badge-sparkle {
    font-size: 0.75rem;
  }

  .col-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 20px;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    z-index: 1;
  }

  .col-icon-cross {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(239, 68, 68, 0.1);
    color: #dc2626;
    border: 1px solid rgba(239, 68, 68, 0.15);
  }

  .col-icon-check {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #2b8bf5 0%, #0071e3 100%);
    color: #fff;
    box-shadow: 0 4px 10px rgba(0, 113, 227, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .col-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 750;
    color: var(--color-label, #1d1d1f);
    letter-spacing: -0.02em;
  }

  .highlight-blue {
    color: #0062c4;
  }

  .col-caption {
    font-size: 0.76rem;
    color: var(--color-secondary-label, #6e6e73);
  }

  .comparison-list {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
    flex-grow: 1;
    z-index: 1;
  }

  .generic-item,
  .specialist-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .generic-item {
    color: #64748b;
  }

  .specialist-item {
    color: #1e293b;
    font-weight: 550;
  }

  .mark-cross {
    color: #ef4444;
    font-weight: 800;
    font-size: 0.92rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .mark-check {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #0071e3;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
    box-shadow: 0 2px 5px rgba(0, 113, 227, 0.3);
  }
</style>
