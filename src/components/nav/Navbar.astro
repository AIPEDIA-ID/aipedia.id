---
import BrandLogo from "../BrandLogo.astro";
import NavLinks from "./NavLinks.astro";
import UserMenu from "./UserMenu.astro";

interface Props {
  user: { name: string; email: string } | null;
  currentPath?: string;
  class?: string;
}

const { user, currentPath = "", class: className = "" } = Astro.props;
---

<header class={`app-navbar-wrapper ${className}`.trim()}>
  <div class="navbar-island">
    <!-- Brand Logo -->
    <BrandLogo size="sm" />

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center">
      <NavLinks currentPath={currentPath} user={user} />
    </div>

    <!-- Actions (User Profile or Sign In) -->
    <div class="navbar-actions flex items-center gap-2">
      <UserMenu user={user} />
    </div>
  </div>
</header>

<style>
  .app-navbar-wrapper {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    display: flex;
    justify-content: center;
    padding: calc(10px + var(--safe-top)) 16px 6px;
    pointer-events: none;
  }

  .navbar-island {
    pointer-events: auto;
    width: 100%;
    max-width: 860px;
    height: 50px;
    padding: 0 10px 0 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--glass-header-bg);
    -webkit-backdrop-filter: var(--glass-header-blur);
    backdrop-filter: var(--glass-header-blur);
    border: 1px solid var(--glass-header-border);
    border-bottom: 1.5px solid rgba(0, 113, 227, 0.16);
    border-radius: 9999px;
    box-shadow: var(--glass-header-shadow);
    transition: all 0.2s ease;
  }

  @media (max-width: 640px) {
    .navbar-island {
      height: 46px;
      padding: 0 8px 0 12px;
    }
  }
</style>
