---
interface Props {
  label: string;
  href: string;
  icon: string;
  count?: number;
}

const { label, href, icon, count } = Astro.props;

const icons: Record<string, string> = {
  "llm-prompt": `<path d="M12 2L2 7l10 5 10-5-10-5z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>`,
  "visual-prompt": `<rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="M21 15l-5-5L5 21" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>`,
  "custom-ai": `<rect x="4" y="4" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="15" cy="10" r="1" fill="currentColor"/><path d="M9 15c1 1 2 1.5 3 1.5s2-.5 3-1.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>`,
  "resource": `<path d="M4 4h16v4H4zM4 10h16v4H4zM4 16h16v4H4z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>`,
  "tutorial": `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>`,
  "founder-space": `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>`,
  "course": `<path d="M2 5l10-3 10 3-10 3-10-3z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/><path d="M6 9v6c0 1 3 3 6 3s6-2 6-3V9" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>`,
};

const iconSvg = icons[icon] ?? icons["resource"];
---

<a href={href} class="category-card">
  <div class="category-icon">
    <svg width="28" height="28" viewBox="0 0 24 24" set:html={iconSvg} />
  </div>
  <span class="category-label">{label}</span>
  {count !== undefined && <span class="category-count">{count}</span>}
</a>

<style>
  .category-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 18px 12px;
    background: var(--color-surface-elevated);
    border-radius: var(--radius-lg);
    border: 0.5px solid var(--color-separator);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    min-height: 44px;
  }
  .category-card:hover {
    text-decoration: none;
    border-color: rgba(0, 122, 255, 0.3);
    box-shadow: 0 2px 12px var(--color-shadow);
  }
  .category-card:active {
    transform: scale(0.96);
  }
  .category-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(0, 122, 255, 0.12);
    color: var(--color-tint);
  }
  .category-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-label);
    text-align: center;
  }
  .category-count {
    font-size: 0.6875rem;
    color: var(--color-secondary-label);
  }
</style>
