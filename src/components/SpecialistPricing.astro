---
interface Props {
  title?: string;
  subtitle?: string;
  singleName?: string;
  singlePrice?: string;
  singleDescription?: string;
  singleFeatures?: string[];
  singleCtaText?: string;
  singleCtaUrl?: string;

  bundleName?: string;
  bundlePrice?: string;
  bundleOriginalPrice?: string;
  bundleBadge?: string;
  bundleDescription?: string;
  bundleFeatures?: string[];
  bundleCtaText?: string;
  bundleCtaUrl?: string;
  bundleBumpNote?: string;

  guaranteeText?: string;
  class?: string;
}

const {
  title = "Pilih Paket Spesialis Anda",
  subtitle = "Investasi satu kali untuk efisiensi kerja bertahun-tahun. Tanpa biaya bulanan tersembunyi.",
  singleName = "Spesialis Tunggal",
  singlePrice = "87.000",
  singleDescription = "Akses CustomGPT spesialis pilihan Anda",
  singleFeatures = [
    "Konsultasi interaktif via ChatGPT",
    "Template dan framework terintegrasi",
    "Panduan penggunaan step-by-step",
  ],
  singleCtaText = "Ambil Paket Ini",
  singleCtaUrl = "#",

  bundleName = "Bundle Spesialis Lengkap",
  bundlePrice = "128.000",
  bundleOriginalPrice = "348.000",
  bundleBadge = "Paling Hemat",
  bundleDescription = "Akses spesialis pilihan + 16 AI Spesialis lainnya",
  bundleFeatures = [
    "Semua fitur paket spesialis tunggal",
    "+ 16 AI Spesialis lainnya (Full Ekosistem)",
    "Bonus Prompt Library & Template SOP",
    "Akses pembaruan dan materi masa depan",
  ],
  bundleCtaText = "Ambil Bundle Lengkap (Hemat 63%)",
  bundleCtaUrl = "#",
  bundleBumpNote = "*Tersedia opsi Agent Skills (+160k) saat checkout untuk pemakaian di Claude & Cursor.",

  guaranteeText = "Garansi 7 Hari Uang Kembali. Jika output spesialis tidak sesuai klaim dan sudah dicoba minimal 1x, dana kami kembalikan 100%.",
  class: className = "",
} = Astro.props;
---

<div class:list={["pricing-section", className]} id="pricing">
  <div class="pricing-header">
    <span class="pricing-kicker">PILIHAN INVESTASI</span>
    <h2 class="pricing-title">{title}</h2>
    {subtitle && <p class="pricing-subtitle">{subtitle}</p>}
  </div>

  <div class="pricing-cards-grid">
    <!-- Single Specialist Card -->
    <div class="pricing-card standard-card">
      <div class="card-glass-shine"></div>

      <div class="card-header">
        <h3 class="tier-name">{singleName}</h3>
        <p class="tier-desc">{singleDescription}</p>
      </div>

      <div class="price-container">
        <div class="price-val">Rp {singlePrice}</div>
        <span class="price-type">Sekali bayar · Akses lifetime</span>
      </div>

      <ul class="features-list">
        {singleFeatures.map((f) => (
          <li>
            <div class="check-box standard-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span>{f}</span>
          </li>
        ))}
      </ul>

      <a href={singleCtaUrl} class="btn-single">
        <span>{singleCtaText}</span>
      </a>
    </div>

    <!-- Bundle Card (Hero Featured) -->
    <div class="pricing-card hero-card">
      <div class="hero-ambient-glow"></div>
      <div class="card-glass-shine"></div>

      {bundleBadge && (
        <div class="hero-badge">
          <span class="badge-sparkle">✦</span>
          <span>{bundleBadge}</span>
        </div>
      )}

      <div class="card-header">
        <h3 class="tier-name hero-title-color">{bundleName}</h3>
        <p class="tier-desc hero-desc-color">{bundleDescription}</p>
      </div>

      <div class="price-container">
        {bundleOriginalPrice && (
          <span class="orig-price">Total eceran: <del>Rp {bundleOriginalPrice}</del></span>
        )}
        <div class="price-val hero-val-color">Rp {bundlePrice}</div>
        <span class="price-type">Sekali bayar · Akses lifetime</span>
      </div>

      <ul class="features-list hero-features">
        {bundleFeatures.map((f) => (
          <li>
            <div class="check-box hero-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span>{f}</span>
          </li>
        ))}
      </ul>

      <a href={bundleCtaUrl} class="btn-bundle">
        <span>{bundleCtaText}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      {bundleBumpNote && <p class="bump-note">{bundleBumpNote}</p>}
    </div>
  </div>

  {guaranteeText && (
    <div class="guarantee-box">
      <div class="guarantee-icon-wrap">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="guarantee-text">{guaranteeText}</p>
    </div>
  )}
</div>

<style>
  .pricing-section {
    margin: 64px 0 48px;
  }

  .pricing-header {
    text-align: center;
    max-width: 620px;
    margin: 0 auto 40px;
  }

  .pricing-kicker {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    color: var(--color-gold-text, #78350f);
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.25);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .pricing-title {
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    font-weight: 800;
    color: var(--color-label, #1d1d1f);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 10px;
  }

  .pricing-subtitle {
    font-size: 0.94rem;
    color: var(--color-secondary-label, #6e6e73);
    line-height: 1.6;
    margin: 0;
  }

  .pricing-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
    max-width: 880px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .pricing-cards-grid {
      grid-template-columns: 1fr;
    }
  }

  .pricing-card {
    position: relative;
    padding: 34px 30px;
    border-radius: 26px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .standard-card {
    background: var(--glass-card-bg);
    border: 1px solid var(--glass-card-border);
    box-shadow: var(--glass-card-shadow);
    backdrop-filter: var(--glass-card-blur);
    -webkit-backdrop-filter: var(--glass-card-blur);
  }

  .hero-card {
    background: linear-gradient(165deg, #ffffff 0%, #f6f9fe 45%, #ecf4ff 100%);
    border: 2px solid rgba(0, 113, 227, 0.38);
    box-shadow:
      0 20px 48px rgba(0, 113, 227, 0.12),
      0 0 0 1px rgba(255, 255, 255, 0.8),
      inset 0 2px 0 #fff;
    transform: scale(1.02);
  }

  @media (max-width: 768px) {
    .hero-card {
      transform: none;
    }
  }

  .hero-ambient-glow {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(242, 201, 76, 0.22) 0%, rgba(0, 113, 227, 0.1) 50%, transparent 70%);
    filter: blur(30px);
    pointer-events: none;
  }

  .hero-badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(180deg, #fff0ad 0%, #f2c94c 54%, #d9ad2f 100%);
    color: #5d3f04;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 5px 15px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(242, 201, 76, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    z-index: 2;
  }

  .badge-sparkle {
    font-size: 0.75rem;
  }

  .card-header {
    position: relative;
    margin-bottom: 22px;
    z-index: 1;
  }

  .tier-name {
    margin: 0 0 6px;
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-label, #1d1d1f);
    letter-spacing: -0.025em;
  }

  .tier-desc {
    margin: 0;
    font-size: 0.83rem;
    color: var(--color-secondary-label, #6e6e73);
    line-height: 1.45;
  }

  .price-container {
    position: relative;
    padding-bottom: 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    z-index: 1;
  }

  .orig-price {
    display: block;
    font-size: 0.78rem;
    color: #94a3b8;
    margin-bottom: 3px;
  }

  .price-val {
    font-size: 2.35rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-label, #1d1d1f);
    line-height: 1.1;
  }

  .hero-val-color {
    color: #0062c4;
  }

  .price-type {
    display: block;
    margin-top: 5px;
    font-size: 0.73rem;
    color: var(--color-tertiary-label, #86868b);
  }

  .features-list {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0 0 30px;
    display: flex;
    flex-direction: column;
    gap: 13px;
    flex-grow: 1;
    z-index: 1;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #475569;
  }

  .hero-features li {
    color: #1e293b;
    font-weight: 550;
  }

  .check-box {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .standard-check {
    background: rgba(0, 0, 0, 0.06);
    color: #475569;
  }

  .hero-check {
    background: linear-gradient(180deg, #2b8bf5 0%, #0071e3 100%);
    color: #fff;
    box-shadow: 0 2px 6px rgba(0, 113, 227, 0.3);
  }

  .btn-single {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    background: linear-gradient(180deg, #ffffff 0%, #f9fafc 40%, #edf1f6 100%);
    color: #1d1d1f;
    border: 1px solid rgba(0, 0, 0, 0.12);
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05), inset 0 1px 0 #fff;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
  }

  .btn-single:hover {
    background: #ffffff;
    border-color: rgba(0, 0, 0, 0.22);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
  }

  .btn-bundle {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 22px;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
    background: linear-gradient(180deg, #fff0ad 0%, #f2c94c 54%, #d9ad2f 100%);
    color: #5d3f04;
    border: 1px solid rgba(217, 173, 47, 0.45);
    box-shadow:
      0 5px 16px rgba(242, 201, 76, 0.38),
      inset 0 1px 0 rgba(255, 255, 255, 0.85);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1;
  }

  .btn-bundle:hover {
    background: linear-gradient(180deg, #fff5c9 0%, #f6d65b 54%, #d1a522 100%);
    transform: translateY(-2px) scale(1.01);
    box-shadow:
      0 8px 22px rgba(242, 201, 76, 0.48),
      inset 0 1px 0 #fff;
  }

  .bump-note {
    position: relative;
    margin: 12px 0 0;
    font-size: 0.73rem;
    color: #64748b;
    text-align: center;
    line-height: 1.45;
    z-index: 1;
  }

  .guarantee-box {
    margin-top: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 22px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.07);
    border: 1px solid rgba(16, 185, 129, 0.22);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .guarantee-icon-wrap {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .guarantee-text {
    margin: 0;
    font-size: 0.8rem;
    color: #065f46;
    line-height: 1.45;
    font-weight: 550;
  }
</style>
