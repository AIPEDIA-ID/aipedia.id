---
import Icon from "../Icon.astro";
import type { User } from "../../lib/data/types";

interface Props {
  user?: User | null;
  activeNav?: string;
  class?: string;
}

const { user = null, activeNav = "", class: className = "" } = Astro.props;

const initials = user
  ? user.name
      .split(" ")
      .map((w) => w[0])
      .join("")
      .slice(0, 2)
      .toUpperCase()
  : "";

const isActive = activeNav === "akun" || activeNav === "account";
---

<div class={`sidebar-user-footer px-2.5 pb-3.5 pt-1 shrink-0 ${className}`.trim()}>
  <a
    href={user ? "/app/account" : "/login"}
    class:list={["sidebar-nav-item sidebar-account-link group", { active: isActive }]}
    title={user ? user.name : "Akun Pengguna"}
  >
    <div
      class:list={[
        "sidebar-avatar w-7 h-7 rounded-lg flex items-center justify-center shrink-0 font-bold text-xs transition-colors shadow-xs",
        user
          ? "bg-[var(--color-tint)] text-white"
          : "bg-[rgba(0,0,0,0.06)] text-[var(--color-secondary-label)]",
      ]}
    >
      {user ? initials : <Icon name="user" size={15} />}
    </div>

    <div class="sidebar-user-info flex-1 min-w-0">
      <p class="sidebar-label text-xs font-bold text-[var(--color-label)] truncate leading-tight">
        {user ? user.name : "Masuk Akun"}
      </p>
      <p class="sidebar-label text-[10px] text-[var(--color-tertiary-label)] truncate">
        {user ? "Pengaturan & Akses" : "Klik untuk login"}
      </p>
    </div>

    <svg
      class="sidebar-label text-[var(--color-tertiary-label)] group-hover:text-[var(--color-label)] shrink-0 transition-transform group-hover:translate-x-0.5"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </a>
</div>
