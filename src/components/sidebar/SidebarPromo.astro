---
import Icon from "../Icon.astro";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`sidebar-promo-container px-2.5 pb-2 pt-2 shrink-0 ${className}`.trim()}>
  <a
    href="/catalog"
    class="upgrade-card card card-interactive block p-3 rounded-2xl no-underline cursor-pointer group"
    title="Lihat Paket Pro & All-Access Pass"
  >
    <div class="upgrade-full">
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs font-bold text-[var(--color-label)]">Upgrade ke Pro</span>
        <span class="badge-vip">
          VIP
        </span>
      </div>
      <p class="text-[11px] text-[var(--color-secondary-label)] mb-2 leading-tight">
        Akses 100+ prompt bisnis & update modul berkala.
      </p>

      <div class="w-full bg-[rgba(0,0,0,0.06)] rounded-full h-1.5 overflow-hidden mb-1.5">
        <div class="bg-[var(--color-tint)] h-1.5 rounded-full" style="width: 40%"></div>
      </div>

      <div class="flex items-center justify-between text-[10px] text-[var(--color-tertiary-label)]">
        <span>60% materi premium</span>
        <span class="font-semibold text-[var(--color-tint)] group-hover:underline">Buka &rarr;</span>
      </div>
    </div>

    <div class="upgrade-mini hidden items-center justify-center py-1 text-[var(--color-tint)]">
      <Icon name="badge" size={18} />
    </div>
  </a>
</div>

<style>
  .upgrade-card {
    background: var(--card-gradient);
    border: 1px solid var(--card-border);
    border-bottom: 2px solid var(--card-border-bottom);
  }
</style>
