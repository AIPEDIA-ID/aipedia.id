---
import Icon from "./Icon.astro";

interface Props {
  name: string;
  href: string;
  itemCount: number;
}

const { name, href, itemCount } = Astro.props;

const formatName = (str: string) => {
  return str.split("-").map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ");
};
---

<a href={href} class="folder-card group">
  <div class="folder-icon-wrap">
    <Icon name="folder" size={24} />
  </div>
  <div class="folder-content">
    <h3 class="folder-name">{formatName(name)}</h3>
    <p class="folder-count">{itemCount} materi</p>
  </div>
</a>

<style>
  .folder-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-separator);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.2s ease, border-color 0.2s;
  }
  .folder-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: var(--color-shadow-md);
    border-color: var(--color-tint);
  }
  .folder-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-fill);
    color: var(--color-tint);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .folder-card:hover .folder-icon-wrap {
    transform: scale(1.05);
  }
  .folder-content {
    min-width: 0;
    flex: 1;
  }
  .folder-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-label);
    margin-bottom: 2px;
    line-height: 1.3;
  }
  .folder-count {
    font-size: 0.8125rem;
    color: var(--color-secondary-label);
  }
</style>
