---
interface Props {
  title?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
  tone?: "default" | "dark";
  class?: string;
}

const {
  title = "Mulai Terapkan AI di Bisnis Anda Sekarang",
  description,
  primaryText = "Lihat Katalog Paket",
  primaryHref = "/catalog",
  secondaryText = "Jelajahi Materi Gratis",
  secondaryHref = "/library",
  tone = "default",
  class: className = "",
} = Astro.props;
---

<div class:list={["closing-cta card card-elevated rounded-2xl overflow-hidden p-8 sm:p-12 text-center max-w-3xl mx-auto", { "closing-cta-dark": tone === "dark" }, className]}>
  <h2
    class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-label)] mb-3"
  >
    {title}
  </h2>
  {description && (
    <p class="text-sm sm:text-base text-[var(--color-secondary-label)] mb-6 max-w-xl mx-auto leading-relaxed">
      {description}
    </p>
  )}
  <div class="flex items-center justify-center gap-3 flex-wrap">
    {primaryHref && primaryText && (
      <a href={primaryHref} class={tone === "dark" ? "btn-gold" : "btn-primary"}>
        <span>{primaryText}</span>
      </a>
    )}
    {secondaryHref && secondaryText && (
      <a href={secondaryHref} class="btn-secondary">
        <span>{secondaryText}</span>
      </a>
    )}
    <slot />
  </div>
</div>

<style>
  .closing-cta-dark {
    border-color: var(--color-dark-border);
    color: var(--color-dark-text);
    background: var(--gradient-dark-panel);
    box-shadow: inset 0 1px rgba(255,255,255,.1), 0 12px 28px rgba(20,25,37,.14);
  }
  .closing-cta-dark h2 { color: var(--color-dark-text); }
  .closing-cta-dark p { color: var(--color-dark-text-muted); }
</style>
